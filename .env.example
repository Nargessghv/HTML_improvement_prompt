# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini

# Database Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Monitoring (Optional)
LANGFUSE_PUBLIC_KEY=your_public_key
LANGFUSE_SECRET_KEY=your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Parallel Processing Features
USE_PARALLEL_SLIDE_PROCESSING=true
USE_PARALLEL_HTML_CONTENT=true
USE_PARALLEL_HTML_REFINEMENT=true

# Assembly Configuration
WAIT_FOR_USER_ASSEMBLY=true  # If true, workflow will pause after slides are complete and wait for user to trigger assembly

# Image Generation Service (Optional)
# For external image generation API
IMAGE_GENERATION_URL=your_image_service_url
IMAGE_GENERATION_API_KEY=your_image_api_key

# Azure Storage (Optional)
AZURE_STORAGE_CONNECTION_STRING=your_connection_string
AZURE_STORAGE_CONTAINER_NAME=your_container_name

# Azure Graph API for Thumbnail Generation (Optional)
AZURE_CLIENT_ID=your_azure_app_client_id
AZURE_CLIENT_SECRET=your_azure_app_client_secret
AZURE_TENANT_ID=your_azure_tenant_id